# このファイルを .env.local にコピーして値を入れる（.env.local はコミットしない）
#   cp .env.example .env.local

# --- Supabase API（認証用） ---
# Supabase Dashboard > Project Settings > API から取得する
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ブラウザ（Google OAuth のリダイレクト等）からも使うので NEXT_PUBLIC_ 付きでも同じ値を置く。
# publishable key は公開前提のキーなので問題ない
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Postgres 接続（Prisma 用） ---
# Supabase Dashboard > Connect > Connection string から取得する
# アプリ実行時：transaction-mode pooler（ポート6543）
DATABASE_URL=
# マイグレーション用：session-mode pooler（ポート5432）
DIRECT_URL=

# --- Gemini API ---
# Google AI Studio（https://aistudio.google.com/apikey）で発行する。サーバー側だけで使うので NEXT_PUBLIC_ は付けない
GEMINI_API_KEY=

# --- デモデータ投入（npm run seed:demo）用。省略時は test@example.com ---
# DEMO_EMAIL=
