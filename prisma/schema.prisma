// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// idはSupabaseのauth.users.id(UUID)と同じ値をそのまま使う。emailなどは持たせず、
// 必要になったらそのとき追加する(Supabase側と二重管理にしない)
model User {
  id String @id @db.Uuid

  logs Log[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// 感情マスタ。code はアプリのロジック(zodのenumなど)から参照する識別子、
// label は画面表示用。列構成は仮置きなので実際の設計に合わせて調整する
model Emotion {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  code  String @unique
  label String

  logs Log[]

  @@map("emotions")
}

model Log {
  id BigInt @id @default(autoincrement())
  // 既存データにuserId未設定の行が残っている可能性があるため、まだNOT NULLにはしていない。
  // 空行が無いことを確認できたらNOT NULL化する
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  emotionId Int?     @map("emotion_id") @db.SmallInt
  emotion   Emotion? @relation(fields: [emotionId], references: [id])

  didToday     String   @map("did_today")
  goodThing    String   @map("good_thing")
  badThing     String?  @map("bad_thing")
  tomorrowPlan String   @map("tomorrow_plan")
  loggedDate   DateTime @map("logged_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, loggedDate])
  @@map("logs")
}
