// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// idはSupabaseのauth.users.id(UUID)と同じ値をそのまま使う。emailなどは持たせず、
// 必要になったらそのとき追加する(Supabase側と二重管理にしない)
model User {
  id String @id @db.Uuid

  logs     Log[]
  tags     Tag[]
  aiUsages AiUsage[]
  insights Insight[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// 感情マスタ。code はアプリのロジック(zodのenumなど)から参照する識別子、
// label は画面表示用。列構成は仮置きなので実際の設計に合わせて調整する
model Emotion {
  id    Int    @id @default(autoincrement()) @db.SmallInt
  code  String @unique
  label String

  logs Log[]

  @@map("emotions")
}

model Log {
  id BigInt @id @default(autoincrement())
  // 既存データにuserId未設定の行が残っている可能性があるため、まだNOT NULLにはしていない。
  // 空行が無いことを確認できたらNOT NULL化する
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  emotionId Int?     @map("emotion_id") @db.SmallInt
  emotion   Emotion? @relation(fields: [emotionId], references: [id])

  didToday     String   @map("did_today")
  goodThing    String   @map("good_thing")
  badThing     String?  @map("bad_thing")
  tomorrowPlan String   @map("tomorrow_plan")
  loggedDate   DateTime @map("logged_date") @db.Date

  tags      LogTag[]
  aiSummary AiSummary?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, loggedDate])
  @@map("logs")
}

// ログ1件ごとのAI分析結果（1対1）。行が無い = まだ分析していない。
// ログ本体とは別テーブルにして、AIの出力でlogsテーブルを汚さない
model AiSummary {
  id    BigInt @id @default(autoincrement())
  logId BigInt @unique @map("log_id")
  log   Log    @relation(fields: [logId], references: [id], onDelete: Cascade)

  keywords  String[] // 感情キーワード（Postgresの text[]）
  summary   String // ひとこと要約
  blogDraft String?  @map("blog_draft") // ブログ下書き。ボタンで生成するまでは null

  // 分析した日時。log.updatedAt の方が新しければ「分析後にログが編集された = 結果が古い」と判定できる
  generatedAt DateTime @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_summaries")
}

// AI生成(分析・ブログ下書き)を使った記録。1回成功するごとに1行増える。
// Gemini の無料枠は APIキー全体で共有なので、1人が使い切らないよう「今日の行数」でユーザーごとに回数を制限する
model AiUsage {
  id     BigInt @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String // "analyze" | "blog_draft"

  createdAt DateTime @default(now()) @map("created_at")

  // 「このユーザーの今日の分」を数えるときの検索用
  @@index([userId, createdAt])
  @@map("ai_usages")
}

// 分析画面の「インサイト（AI）」。ユーザー × 期間(7/30/90日)ごとに最新の傾向文を1つだけ持つ。
// 画面を開くたびに AI を呼ばないよう、作った結果をここに保存して使い回す
model Insight {
  id         BigInt @id @default(autoincrement())
  userId     String @map("user_id") @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodDays Int    @map("period_days") @db.SmallInt // 対象期間（今日を含む直近N日）
  content    String // 傾向文

  generatedAt DateTime @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, periodDays])
  @@map("insights")
}

// タグ（「FF14」「零式」など）。ユーザーごとに持ち、同じユーザー内では名前が重複しない
model Tag {
  id     BigInt @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  logs LogTag[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, name])
  @@map("tags")
}

// ログとタグの中間テーブル（1つのログに複数タグ、1つのタグに複数ログ = 多対多）。
// ログやタグが消えたら紐づけも一緒に消す(onDelete: Cascade)
model LogTag {
  logId BigInt @map("log_id")
  log   Log    @relation(fields: [logId], references: [id], onDelete: Cascade)
  tagId BigInt @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([logId, tagId])
  @@map("log_tags")
}
